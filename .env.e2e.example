# Copy to .env.e2e (gitignored). Used only by `npm run test:e2e`.
# NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY come from .env (non-production).

# Secret API key (sb_secret_...) of the NON-PRODUCTION Supabase project
# (Supabase > Project Settings > API Keys). Full database access: never put it in
# .env, Vercel, or anywhere the app can read it, and never use the production key.
# (A legacy service role key also works, as E2E_SUPABASE_SERVICE_ROLE_KEY.)
E2E_SUPABASE_SECRET_KEY=""

# Optional: run against staging instead of localhost.
# E2E_BASE_URL="https://<staging-domain>"
# Vercel > Settings > Deployment Protection > Protection Bypass for Automation
# E2E_VERCEL_BYPASS_SECRET=""

# Optional: run the tests' database setup/cleanup against another schema, e.g.
# the staging schema (must match the database the app under test uses).
# E2E_DATABASE_URL=""
