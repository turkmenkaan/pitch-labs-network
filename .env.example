# Copy to .env and fill in. Local development uses the NON-PRODUCTION Supabase
# project (public schema). Never put production credentials in .env.

# Pooled connection (Supabase transaction pooler, port 6543) used at runtime.
DATABASE_URL="postgresql://postgres.<nonprod-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct connection used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:<password>@db.<nonprod-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<nonprod-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable key from Supabase > Settings > API>"

# Production migrations only: put the production values in .env.prod-migrate
# (gitignored), then run `npm run db:migrate:prod`.

# Slack notifications (see README "Slack notifications").
# off = send nothing, log = record + log only (default), slack = really send.
NOTIFY_MODE="log"
# Bot token (xoxb-...) with chat:write, users:read, users:read.email.
SLACK_BOT_TOKEN=""
# Optional: comma-separated emails; when set, only they get real Slack messages.
NOTIFY_ALLOWLIST=""
# Public URL of this deployment, used for links in messages.
APP_URL=""
# Shared secret for the retry cron (/api/notifications/sweep).
CRON_SECRET=""
