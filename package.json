{
  "name": "pitch-labs-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate-on-build.ts && prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "seed:staging": "tsx scripts/with-staging.ts tsx prisma/seed.ts",
    "make-admin:staging": "tsx scripts/with-staging.ts tsx scripts/make-admin.ts",
    "db:reset": "tsx scripts/guard-not-production.ts && prisma migrate reset --force",
    "db:migrate:staging": "tsx scripts/migrate.ts staging",
    "db:migrate:prod": "tsx scripts/migrate.ts prod",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
